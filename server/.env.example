# Copy this file to .env and fill it in
MONGODB_URI=mongodb://127.0.0.1:27017/portfolio
# Pick any long secret. You type it on the /#/admin page to add or delete projects.
ADMIN_KEY=change-me-to-something-long
PORT=5000
# Your frontend address(es), comma separated. Add your deployed URL later.
CLIENT_ORIGIN=http://localhost:5173
